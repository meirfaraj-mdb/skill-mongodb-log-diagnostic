# Non-secret application configuration. Copy to your deployment env file and
# replace example values. Do not commit credentials or private keys.
# Choices are documented as [OPTION1|OPTION2]; keep the assignment itself set
# to one valid value so this file can be sourced as a shell environment file.

# Runtime/cloud selection
# Allowed: [aws|gcp|local]
CLOUD_PROVIDER=gcp

# Input source
# Allowed: [atlas_api|existing_bucket]
# existing_bucket reads previously uploaded inputs and does not call Atlas.
MONGODB_LOG_DIAG_INPUT_MODE=existing_bucket

# Required for atlas_api mode. The referenced Secret Manager secret must contain
# ONLY atlas_public_key and atlas_private_key. Inject/authorize this reference
# only when using atlas_api; omit it for existing_bucket mode.
# GCP example: ATLAS_SECRET_ID=projects/YOUR_GCP_PROJECT/secrets/YOUR_SECRET/versions/latest
# AWS example: ATLAS_SECRET_ID=arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:SECRET_NAME
# Local atlas_api only: ATLAS_CONFIG_FILE=/secure/path/atlas-credentials.json

# Atlas project/cluster settings (required as applicable in atlas_api mode)
MONGODB_LOG_DIAG_GROUP_ID=YOUR_24_CHARACTER_ATLAS_PROJECT_ID
MONGODB_LOG_DIAG_CLUSTER_NAME=my-cluster
MONGODB_LOG_DIAG_TIMEZONE=Asia/Jerusalem
MONGODB_LOG_DIAG_API_VERSION=2025-03-12
# Atlas log names: auto selects by process; otherwise comma-separated names,
# commonly mongodb,mongos (for example: mongodb,mongos).
MONGODB_LOG_DIAG_LOG_NAMES=auto
# Optional regex over hostname/userAlias; ignored when exact hostnames are configured elsewhere.
MONGODB_LOG_DIAG_HOST_SELECTOR=^my-cluster-
MONGODB_LOG_DIAG_HTTP_TIMEOUT_SECONDS=120
MONGODB_LOG_DIAG_MAX_RETRIES=5

# Storage
# Allowed: [s3|gcs|local]. Defaults from CLOUD_PROVIDER when omitted.
MONGODB_LOG_DIAG_STORAGE_PROVIDER=gcs
# Results bucket: generated extracts and reports are written here.
MONGODB_LOG_DIAG_BUCKET=YOUR_RESULTS_BUCKET
# Input bucket defaults to MONGODB_LOG_DIAG_BUCKET when blank or omitted.
# Keep both buckets on the same storage backend. For local storage, use a path.
MONGODB_LOG_DIAG_INPUT_BUCKET=YOUR_INPUT_BUCKET
MONGODB_LOG_DIAG_PREFIX=atlas-logs
# Optional cloud storage settings
MONGODB_LOG_DIAG_AWS_REGION=us-east-1
MONGODB_LOG_DIAG_GCP_PROJECT=YOUR_GCP_PROJECT

# Extraction and reports
MONGODB_LOG_DIAG_SLOW_MS=1000
MONGODB_LOG_DIAG_EXPECTED_NODE_COUNT=3
MONGODB_LOG_DIAG_REPORT_MAX_TOKENS=16000
MONGODB_LOG_DIAG_REPORT_MAX_INPUT_CHARS=600000
# Boolean: [true|false]
MONGODB_LOG_DIAG_CLUSTER_SUMMARY=true

# Report LLM provider
# Allowed: [bedrock|vertex|anthropic|claude_cli]
MONGODB_LOG_DIAG_LLM_PROVIDER=vertex

# AWS Bedrock (when LLM_PROVIDER=bedrock)
MONGODB_LOG_DIAG_BEDROCK_MODEL_ID=YOUR_BEDROCK_MODEL_OR_INFERENCE_PROFILE_ID
MONGODB_LOG_DIAG_BEDROCK_REGION=us-east-1

# Vertex AI (when LLM_PROVIDER=vertex)
MONGODB_LOG_DIAG_VERTEX_MODEL=gemini-2.5-flash
MONGODB_LOG_DIAG_VERTEX_LOCATION=us-central1
MONGODB_LOG_DIAG_VERTEX_PROJECT=YOUR_GCP_PROJECT
# ADK orchestration uses a separate Gemini model.
MONGODB_LOG_DIAG_ADK_MODEL=gemini-2.5-flash

# Direct Anthropic (when LLM_PROVIDER=anthropic): configure this as a secret in
# the deployment platform; never put the real key in this file.
# ANTHROPIC_API_KEY=INJECT_FROM_SECRET_MANAGER
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Local Claude CLI (when LLM_PROVIDER=claude_cli)
# CLAUDE_CLI_MODEL=YOUR_CLI_MODEL

# Note: this repository version's providers.py does not map the optional
# mongodb-observability skill schema fields (for example observability_enabled,
# index_stats_enabled, query_shape_source) from environment variables. Do not
# assume setting MONGODB_LOG_DIAG_OBSERVABILITY_* has an effect until the config
# loader is extended to consume those fields.

# Per-node metric graphs (report APPENDIX 2, one A4 page per node)
# MONGODB_LOG_DIAG_METRICS_GRANULARITY=PT5M
# MONGODB_LOG_DIAG_METRICS_GRAPHS_ENABLED=true
# MONGODB_LOG_DIAG_METRICS_GRAPH_GROUPS=["CACHE","CONNECTIONS_AND_CURSORS","OPCOUNTERS_PRIMARY","SYSTEM_MEMORY"]

