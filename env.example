# Non-secret application configuration. Copy to your deployment env file and
# replace example values. Do not commit credentials or private keys.
# Choices are documented as [OPTION1|OPTION2]; keep the assignment itself set
# to one valid value so this file can be sourced as a shell environment file.

# Runtime/cloud selection
# Allowed: [aws|gcp|local]
CLOUD_PROVIDER=gcp

# Input source
# Allowed: [atlas_api|existing_bucket]
# existing_bucket reads previously uploaded inputs and does not call Atlas.
MONGODB_LOG_DIAG_INPUT_MODE=existing_bucket

# Required for atlas_api mode. The referenced Secret Manager secret must contain
# ONLY atlas_public_key and atlas_private_key. Inject/authorize this reference
# only when using atlas_api; omit it for existing_bucket mode.
# GCP example: ATLAS_SECRET_ID=projects/YOUR_GCP_PROJECT/secrets/YOUR_SECRET/versions/latest
# AWS example: ATLAS_SECRET_ID=arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:SECRET_NAME
# Local atlas_api only: ATLAS_CONFIG_FILE=/secure/path/atlas-credentials.json

# Atlas project/cluster settings (required as applicable in atlas_api mode)
MONGODB_LOG_DIAG_GROUP_ID=YOUR_24_CHARACTER_ATLAS_PROJECT_ID
MONGODB_LOG_DIAG_CLUSTER_NAME=my-cluster
MONGODB_LOG_DIAG_TIMEZONE=Asia/Jerusalem
MONGODB_LOG_DIAG_API_VERSION=2025-03-12
# Atlas log names: auto selects by process; otherwise comma-separated names,
# commonly mongodb,mongos (for example: mongodb,mongos).
MONGODB_LOG_DIAG_LOG_NAMES=auto
# Optional regex over hostname/userAlias; ignored when exact hostnames are configured elsewhere.
MONGODB_LOG_DIAG_HOST_SELECTOR=^my-cluster-
MONGODB_LOG_DIAG_HTTP_TIMEOUT_SECONDS=120
MONGODB_LOG_DIAG_MAX_RETRIES=5

# Storage
# Allowed: [s3|gcs|local]. Defaults from CLOUD_PROVIDER when omitted.
MONGODB_LOG_DIAG_STORAGE_PROVIDER=gcs
# Results bucket: generated extracts and reports are written here.
MONGODB_LOG_DIAG_BUCKET=YOUR_RESULTS_BUCKET
# Input bucket defaults to MONGODB_LOG_DIAG_BUCKET when blank or omitted.
# Keep both buckets on the same storage backend. For local storage, use a path.
MONGODB_LOG_DIAG_INPUT_BUCKET=YOUR_INPUT_BUCKET
MONGODB_LOG_DIAG_PREFIX=atlas-logs
# Optional cloud storage settings
MONGODB_LOG_DIAG_AWS_REGION=us-east-1
MONGODB_LOG_DIAG_GCP_PROJECT=YOUR_GCP_PROJECT

# Extraction and reports
MONGODB_LOG_DIAG_SLOW_MS=1000
MONGODB_LOG_DIAG_EXPECTED_NODE_COUNT=3
MONGODB_LOG_DIAG_REPORT_MAX_TOKENS=16000
# Max characters sent to the model per node report. Leave unset for the per-node default:
# 80000, or 200000 when the node has metrics and the resource investigation runs (busy nodes keep the
# occurrences of every high-resource episode and hot-document window). Lower it for small-context models.
# MONGODB_LOG_DIAG_REPORT_MAX_INPUT_CHARS=80000
# Boolean: [true|false]
MONGODB_LOG_DIAG_CLUSTER_SUMMARY=true
# Which cluster summary to build. Allowed: [extract|node_reports|both]
#   extract      -> cluster-summary.md (node reports + extract trend alerts + query-shape evidence)
#   node_reports -> cluster-summary.from-node-reports.md (only the node report.md files)
#   both         -> both files, to compare them
# The stage `cluster-summary-md` builds only the node_reports variant from existing reports.
MONGODB_LOG_DIAG_CLUSTER_SUMMARY_SOURCE=extract
# Boolean: [true|false]  Skip the Query Shape Insights call when the node already has rows.
MONGODB_LOG_DIAG_QUERY_STATS_SKIP_EXISTING=true
# Boolean: [true|false]  When every per-node QSI call fails/empty, copy the cluster-wide
# result into each node file (marked scope=cluster; the API gives no per-node attribution).
MONGODB_LOG_DIAG_QUERY_SHAPE_SPLIT_TO_NODES=true
# Boolean: [true|false]  Also report unreviewed OSV catalog matches, labelled unreviewed_candidate.
MONGODB_LOG_DIAG_OFFLINE_CVE_INCLUDE_UNREVIEWED=false

# Report LLM provider
# Allowed: [bedrock|vertex|anthropic|claude_cli]
MONGODB_LOG_DIAG_LLM_PROVIDER=vertex

# AWS Bedrock (when LLM_PROVIDER=bedrock)
MONGODB_LOG_DIAG_BEDROCK_MODEL_ID=YOUR_BEDROCK_MODEL_OR_INFERENCE_PROFILE_ID
MONGODB_LOG_DIAG_BEDROCK_REGION=us-east-1

# Vertex AI (when LLM_PROVIDER=vertex)
MONGODB_LOG_DIAG_VERTEX_MODEL=gemini-2.5-flash
MONGODB_LOG_DIAG_VERTEX_LOCATION=us-central1
MONGODB_LOG_DIAG_VERTEX_PROJECT=YOUR_GCP_PROJECT
# ADK orchestration uses a separate Gemini model.
MONGODB_LOG_DIAG_ADK_MODEL=gemini-2.5-flash

# Direct Anthropic (when LLM_PROVIDER=anthropic): configure this as a secret in
# the deployment platform; never put the real key in this file.
# ANTHROPIC_API_KEY=INJECT_FROM_SECRET_MANAGER
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Local Claude CLI (when LLM_PROVIDER=claude_cli)
# CLAUDE_CLI_MODEL=YOUR_CLI_MODEL

# Note: this repository version's providers.py does not map the optional
# mongodb-observability skill schema fields (for example observability_enabled,
# index_stats_enabled, query_shape_source) from environment variables. Do not
# assume setting MONGODB_LOG_DIAG_OBSERVABILITY_* has an effect until the config
# loader is extended to consume those fields.

# Per-node metric graphs (report APPENDIX 1, one A4 page per node)
# MONGODB_LOG_DIAG_METRICS_GRANULARITY=PT5M
# MONGODB_LOG_DIAG_METRICS_GRAPHS_ENABLED=true
# Write contention (hot document) findings from the full extract (parser >= 1.6) and their embedded graph.
# MONGODB_LOG_DIAG_CONCURRENCY_FINDINGS_ENABLED=true
# MONGODB_LOG_DIAG_CONCURRENCY_GRAPHS_ENABLED=true
# JSON overrides of agent/concurrency_findings.DEFAULT_THRESHOLDS, e.g. {"contention_min_target_share":0.6}
# MONGODB_LOG_DIAG_CONCURRENCY_THRESHOLDS={}
# MONGODB_LOG_DIAG_METRICS_GRAPH_GROUPS=["CACHE","CONNECTIONS_AND_CURSORS","OPCOUNTERS_PRIMARY","SYSTEM_MEMORY"]

# Performance Advisor appendix (report APPENDIX 2, only when advisor/advisor.json has data)
# MONGODB_LOG_DIAG_ADVISOR_APPENDIX_ENABLED=true

# Cluster summary: new or sharply increasing issues vs n-1 AND n-8 (both baselines required)
# MONGODB_LOG_DIAG_TREND_INCREASE_PCT=200       # flag at >= +200% (3x) vs n-1 or n-8
# MONGODB_LOG_DIAG_TREND_MIN_ABS_INCREASE=5     # and at least 5 more occurrences (new items: no floor)
# MONGODB_LOG_DIAG_TREND_RATIO_THRESHOLD=100    # docs examined/returned >= 100 = poorly indexed


# ---------------------------------------------------------------------------
# Per-environment notifications from the cluster reports (agent/notifications.py)
# P0 -> Jira, P1 -> Slack. Each channel: off (default, unchanged behaviour) | json | create/send.
# Runs automatically after the cluster summary; re-run alone with `--stage notify`.
# Output under <prefix>/<day>/cluster/reports/: notifications.json, jira-issues.json (json mode),
# slack-messages.json (json mode). De-dup ledger: <prefix>/notifications/<env>/<cluster>/ledger.json
# ---------------------------------------------------------------------------
# MONGODB_LOG_DIAG_ENVIRONMENT=production            # dev | staging | production (any short slug)
# MONGODB_LOG_DIAG_NOTIFY_SOURCE=auto                 # auto (cluster summary, node reports as fallback) | cluster_summary | node_reports
# MONGODB_LOG_DIAG_NOTIFY_AFTER_REPORT=true           # false: only via --stage notify
# Per-environment overrides when one config is shared by several deployments:
# MONGODB_LOG_DIAG_NOTIFY_ENV_OVERRIDES={"dev":{"jira_mode":"off","slack_mode":"json"},"staging":{"jira_mode":"json"},"production":{"jira_mode":"create","slack_mode":"send","jira_assignee":"5b10ac8d82e05b22cc7d4ef5"}}

# Jira (P0)
# MONGODB_LOG_DIAG_JIRA_MODE=off                     # off | json | create
# MONGODB_LOG_DIAG_JIRA_PRIORITIES=P0                # comma list
# MONGODB_LOG_DIAG_JIRA_BASE_URL=https://your-org.atlassian.net   # required for create
# MONGODB_LOG_DIAG_JIRA_DEPLOYMENT=cloud             # cloud (email+API token, accountId) | datacenter (PAT, username)
# MONGODB_LOG_DIAG_JIRA_PROJECT_KEY=OPS              # required for json/create
# MONGODB_LOG_DIAG_JIRA_ISSUE_TYPE=Bug
# MONGODB_LOG_DIAG_JIRA_ASSIGNEE=                    # Cloud accountId, or Data Center username
# MONGODB_LOG_DIAG_JIRA_ASSIGNEE_FIELD=              # default: accountId (cloud) / name (datacenter)
# MONGODB_LOG_DIAG_JIRA_PRIORITY_MAP={"P0":"Highest","P1":"High","P2":"Medium","P3":"Low"}
# MONGODB_LOG_DIAG_JIRA_LABELS=mongodb,log-diagnostic   # no spaces; mldiag-<fingerprint> + mldiag-env-<env> are always added
# MONGODB_LOG_DIAG_JIRA_COMPONENTS=Database
# MONGODB_LOG_DIAG_JIRA_PARENT_KEY=OPS-100           # parent/epic in team-managed projects
# MONGODB_LOG_DIAG_JIRA_EPIC_KEY=OPS-100             # classic projects: with JIRA_EPIC_LINK_FIELD
# MONGODB_LOG_DIAG_JIRA_EPIC_LINK_FIELD=customfield_10014
# MONGODB_LOG_DIAG_JIRA_EXTRA_FIELDS={"customfield_10050":{"value":"MongoDB"}}
# MONGODB_LOG_DIAG_JIRA_DEDUPE_SCOPE=open            # open: new ticket if the previous one is Done | all: never re-create
# MONGODB_LOG_DIAG_JIRA_COMMENT_ON_EXISTING=false    # comment "still observed" on the existing ticket (once per day)
# MONGODB_LOG_DIAG_JIRA_MAX_ISSUES=10
# MONGODB_LOG_DIAG_JIRA_SUMMARY_TEMPLATE=[{environment}] {cluster}: {finding}   # also {priority} {date}

# Slack (P1)
# MONGODB_LOG_DIAG_SLACK_MODE=off                    # off | json | send
# MONGODB_LOG_DIAG_SLACK_PRIORITIES=P1
# MONGODB_LOG_DIAG_SLACK_CHANNEL=#mongodb-alerts     # required with slack_bot_token; ignored by webhooks
# MONGODB_LOG_DIAG_SLACK_MENTIONS=<!subteam^S0123ABC>,<@U0123ABC>
# MONGODB_LOG_DIAG_SLACK_REPEAT_AFTER_DAYS=0         # 0: notify every day the issue is present; N: at most once per N days
# MONGODB_LOG_DIAG_SLACK_MAX_FINDINGS=10

# Notification credentials: a SEPARATE secret (the Atlas secret must contain only Atlas keys).
# Allowed keys: jira_email, jira_api_token, jira_pat, slack_webhook_url, slack_bot_token
# NOTIFICATION_SECRET_ID=arn:aws:secretsmanager:...:secret:mongodb-log-diag-notifications   # or projects/<p>/secrets/<s>/versions/latest
# NOTIFICATION_CONFIG_FILE=./secret.notifications.json                                     # local runs
