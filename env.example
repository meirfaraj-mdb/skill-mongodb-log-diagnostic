# Non-secret runtime configuration. Inject through your deployment platform.
# Existing-bucket mode: set INPUT_MODE=existing_bucket and omit ATLAS_SECRET_ID.
# Atlas API mode: secret JSON contains ONLY atlas_public_key and atlas_private_key.
# Set ATLAS_SECRET_ID in your deployment to the Secret Manager resource name (not its value).
# LOG_NAMES is comma-separated; booleans are true/false; integers use decimal values.
MONGODB_LOG_DIAG_INPUT_MODE=atlas_api
MONGODB_LOG_DIAG_GROUP_ID=YOUR_24_CHARACTER_PROJECT_ID
MONGODB_LOG_DIAG_CLUSTER_NAME=my-cluster
MONGODB_LOG_DIAG_TIMEZONE=Asia/Jerusalem
MONGODB_LOG_DIAG_API_VERSION=2025-03-12
MONGODB_LOG_DIAG_LOG_NAMES=auto
MONGODB_LOG_DIAG_HOST_SELECTOR=^my-cluster-
MONGODB_LOG_DIAG_HTTP_TIMEOUT_SECONDS=120
MONGODB_LOG_DIAG_MAX_RETRIES=5
MONGODB_LOG_DIAG_BUCKET=my-atlas-log-bucket
MONGODB_LOG_DIAG_PREFIX=atlas-logs
MONGODB_LOG_DIAG_SLOW_MS=1000
MONGODB_LOG_DIAG_EXPECTED_NODE_COUNT=3
MONGODB_LOG_DIAG_REPORT_MAX_TOKENS=16000
MONGODB_LOG_DIAG_REPORT_MAX_INPUT_CHARS=600000
MONGODB_LOG_DIAG_CLUSTER_SUMMARY=true
MONGODB_LOG_DIAG_LLM_PROVIDER=vertex
# AWS-only (if provider=bedrock):
MONGODB_LOG_DIAG_BEDROCK_MODEL_ID=YOUR_BEDROCK_MODEL_OR_PROFILE_ID
MONGODB_LOG_DIAG_BEDROCK_REGION=us-east-1
# GCP-only (if provider=vertex):
MONGODB_LOG_DIAG_VERTEX_MODEL=claude-sonnet-5
MONGODB_LOG_DIAG_VERTEX_LOCATION=us-central1
MONGODB_LOG_DIAG_VERTEX_PROJECT=my-gcp-project
# ADK orchestration needs a separate Gemini model, even if report model is Claude:
MONGODB_LOG_DIAG_ADK_MODEL=gemini-2.5-flash
