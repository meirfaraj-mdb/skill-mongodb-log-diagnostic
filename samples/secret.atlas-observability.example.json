{
  "input_mode": "atlas_api",
  "bucket": "my-mongodb-diagnostic-bucket",
  "prefix": "staging-logs",
  "timezone": "Asia/Jerusalem",
  "cluster_name": "my-atlas-cluster",
  "atlas_public_key": "ATLAS_API_PUBLIC_KEY",
  "atlas_private_key": "ATLAS_API_PRIVATE_KEY",
  "group_id": "ATLAS_PROJECT_ID",
  "observability_enabled": true,
  "deployment_type": "atlas",
  "mongodb_uri_template": "mongodb://READ_ONLY_USER:URL_ENCODED_PASSWORD@{host}:27017/?tls=true&authSource=admin",
  "index_stats_hosts": [
    "hostname1",
    "hostname2",
    "hostname3"
  ],
  "atlas_process_ids": {
    "hostname1": "hostname1:27017",
    "hostname2": "hostname2:27017",
    "hostname3": "hostname3:27017"
  },
  "index_stats_max_collections": 1000,
  "query_stats_max_summaries": 100,
  "atlas_query_stats_url": "https://cloud.mongodb.com/api/atlas/v2/groups/{group_id}/clusters/{cluster_name}/queryShapeInsights/summaries",
  "query_shape_source": "atlas_api",
  "query_shape_window_hours": 24,
  "index_stats_enabled": true
}
