{
  "input_mode": "atlas_api",
  "bucket": "my-unique-diagnostic-test-bucket",
  "prefix": "local-atlas-test",
  "timezone": "Asia/Jerusalem",
  "cluster_name": "my-atlas-cluster",

  "atlas_public_key": "ATLAS_API_PUBLIC_KEY",
  "atlas_private_key": "ATLAS_API_PRIVATE_KEY",
  "group_id": "ATLAS_PROJECT_ID",
  "api_version": "2025-03-12",
  "log_names": ["auto"],

  "storage_provider": "s3",
  "llm_provider": "bedrock",
  "bedrock_region": "eu-west-1",
  "bedrock_model_id": "eu.anthropic.claude-sonnet-5",

  "observability_enabled": false,
  "report_max_tokens": 16000,
  "report_max_input_chars": 600000
}
