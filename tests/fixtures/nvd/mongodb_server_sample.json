  {
   "cve": {
    "id": "CVE-2026-118383",
    "sourceIdentifier": "cna@mongodb.com",
    "published": "2026-11-10T21:18:58.980",
    "lastModified": "2026-11-13T15:56:12.173",
    "vulnStatus": "Analyzed",
    "cveTags": [],
    "descriptions": [
     {
      "lang": "en",
      "value": "A use-after-free in the replication component of MongoDB Server can occur when a newly elected replica set primary completes catch-up.The condition can be caused by requests that do not require authentication, and may result in the server terminating unexpectedly or, under certain conditions, arbitrary code execution in the context of the server process.Replica set members are affected, including the shard and config server replica set members of sharded clusters; standalone mongod instances are not."
     }
    ],
