# Non-secret Atlas Agent Engine configuration. Set secrets through the platform,
# not in this file or source control.

# Orchestration model (separate from MONGODB_LOG_DIAG_LLM_PROVIDER for reports)
ATLAS_AGENT_MODEL_PROVIDER=bedrock  # [bedrock|anthropic-compatible]
ATLAS_AGENT_MODEL=YOUR_ACCESSIBLE_MODEL_ID
ATLAS_AGENT_MODEL_REGION=us-east-1
# For anthropic-compatible endpoints only:
# ATLAS_AGENT_MODEL_BASE_URL=https://YOUR_APPROVED_ENDPOINT
# Set LLM_API_KEY as an Atlas Agent Engine secret; never put its value here.

# Shared pipeline runtime/storage backend (Atlas Agent Engine is not a CLOUD_PROVIDER)
MONGODB_LOG_DIAG_PIPELINE_CLOUD=aws  # [aws|gcp|local]
MONGODB_LOG_DIAG_INPUT_MODE=existing_bucket  # [atlas_api|existing_bucket]
MONGODB_LOG_DIAG_BUCKET=YOUR_OUTPUT_BUCKET
MONGODB_LOG_DIAG_INPUT_BUCKET=YOUR_INPUT_BUCKET
MONGODB_LOG_DIAG_STORAGE_PROVIDER=s3  # [s3|gcs|local]
MONGODB_LOG_DIAG_PREFIX=atlas-logs
MONGODB_LOG_DIAG_TIMEZONE=Asia/Jerusalem
MONGODB_LOG_DIAG_CLUSTER_NAME=MongoDB cluster
MONGODB_LOG_DIAG_LLM_PROVIDER=bedrock  # [bedrock|vertex|anthropic|claude_cli]
MONGODB_LOG_DIAG_BEDROCK_MODEL_ID=YOUR_REPORT_MODEL_ID
MONGODB_LOG_DIAG_BEDROCK_REGION=us-east-1

# Atlas API input mode: use either the existing AWS/GCP secret reference, or
# store MONGODB_LOG_DIAG_ATLAS_CREDENTIALS_JSON as a platform secret containing
# only atlas_public_key and atlas_private_key. Do not put key values here.
# ATLAS_SECRET_ID=YOUR_SECRET_RESOURCE_NAME
